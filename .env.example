# Secret used to sign session cookies. REQUIRED in production (32+ random chars).
AUTH_SECRET=change-me-to-a-long-random-string

# Household timezone used to decide when daily/weekly quests reset.
APP_TIMEZONE=America/New_York

# Leave these empty to run in demo mode (local JSON store in .data/).
# Fill them in to switch the whole app to Supabase (see supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY name also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Currency shown next to XP (100 XP = 1 unit).
NEXT_PUBLIC_CURRENCY=USD
